# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=متجر زكي AI Agent
APP_VERSION=2.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Agent LLM (DeepSeek via SovereignEG — OpenAI compatible) ─────────────────
SOVEREIGNEG_API_KEY=your_api_key_here
LLM_BASE_URL=https://backend.sovereigneg.com/v1
LLM_MODEL=deepseek-v4-flash-0731
LLM_TEMPERATURE=0.3
AGENT_MAX_STEPS=8

# ── Multi-modal (Gemini STT + Vision) ─────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Embeddings (Semantic search) ───────────────────────────────────────────────
# auto = Cohere if COHERE_API_KEY set, else SovereignEG /v1/embeddings
EMBEDDING_PROVIDER=auto
COHERE_API_KEY=
COHERE_MODEL=embed-multilingual-v3.0
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── PostgreSQL (pgvector) ─────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=zaki
POSTGRES_PASSWORD=zakipass
POSTGRES_DB=zaki_store

# ── API ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["*"]

# ── WhatsApp / Twilio ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=